# ─────────────────────────────────────────────────────────────────────────────
# The Engineers Club — Contract Dashboard
# Copy to .env.local for local development; add the same values in Vercel →
# Project → Settings → Environment Variables for production.
# NEVER prefix secrets with NEXT_PUBLIC_ — none of these are sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (used in signing links and emails). No trailing slash.
APP_URL=http://localhost:3000

# Leave everything below empty to run in DEMO MODE (local data, simulated
# signatures and emails, all clearly labelled). Set DEMO_MODE=true to force
# demo behaviour even when some integrations are configured.
DEMO_MODE=

# ── Secrets (required in production) ── generate each with: openssl rand -base64 48
SESSION_SECRET=
SIGNING_LINK_SECRET=
CRON_SECRET=

# ── Supabase (database, staff auth, private PDF storage) ──
# Supabase → Project Settings → API
SUPABASE_URL="https://uvuxyrscqdajalqwfkbs.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_ZMuzFpakC_ObmOgBYi3g1Q_bkBkbbBF"
SUPABASE_SERVICE_ROLE_KEY=

# ── Dropbox Sign (e-signatures) ──
# API key: Dropbox Sign → Settings → API. Client ID: your API app.
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_CLIENT_ID=
# true = free test mode (watermarked, NOT legally binding). Set to false for live contracts.
DROPBOX_SIGN_TEST_MODE=true

# ── Resend (transactional email) ──
RESEND_API_KEY=
# Must be on a domain verified in Resend
EMAIL_FROM="The Engineers Club <contracts@theengineers.club>"
EMAIL_REPLY_TO=hello@theengineers.club
# Receives a copy of every signed agreement
BUSINESS_NOTIFICATION_EMAIL=contracts@theengineers.club

# ── Policy (optional) ──
SIGNING_LINK_TTL_DAYS=30
# Signed contracts are kept for this many years after membership end, then personal data is erased
RETENTION_YEARS=7
# Unsent drafts are deleted after this many days
DRAFT_RETENTION_DAYS=90

# ── Demo mode only (optional fixed demo logins; otherwise generated) ──
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_SALES_EMAIL=
DEMO_SALES_PASSWORD=
